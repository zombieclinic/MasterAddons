{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.halloween_witch": {
            "initial_state": "idle",
            "states": {
                "idle": {
                    "animations": [
                        "idle"
                    ],
                    "transitions": [
                        {"walk": "query.ground_speed >= 0.01"}
                    ]
                },
                "walk": {
                    "animations": [
                        "walk"
                    ],
                    "transitions": [
                        {"idle": "!query.ground_speed"}
                    ]
                }
            }
        }   
    }
}