{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.imp": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "transitions": [
            { "attack": "variable.attack_time > 0.0" },
            { "fly": "!query.is_on_ground" },
            { "walk": "query.modified_move_speed > 0.01" }
          ]
        },
        "walk": {
          "animations": ["walk"],
          "transitions": [
            { "attack": "variable.attack_time > 0.0" },
            { "fly": "!query.is_on_ground" },
            { "idle": "query.modified_move_speed <= 0.01" }
          ]
        },
        "fly": {
          "animations": ["fly"],
          "transitions": [
            { "attack": "variable.attack_time > 0.0" },
            { "walk": "query.is_on_ground && query.modified_move_speed > 0.01" },
            { "idle": "query.is_on_ground && query.modified_move_speed <= 0.01" }
          ]
        },
        "attack": {
          "animations": ["attack"],
          "transitions": [
            { "fly": "query.all_animations_finished && !query.is_on_ground" },
            { "walk": "query.all_animations_finished && query.modified_move_speed > 0.01" },
            { "idle": "query.all_animations_finished" }
          ]
        }
      }
    }
  }
}
