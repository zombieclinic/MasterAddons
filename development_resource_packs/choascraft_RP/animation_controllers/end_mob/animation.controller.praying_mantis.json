{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.praying_mantis": {
			"initial_state": "default",
			"states": {
				"default": {
					"blend_transition": 0.2,
					"transitions": [
						{
							"attack": "variable.attack_time > 0.0"
						},
						{
							"walking": "query.ground_speed > 0.02"
						}
					],
					"animations": [
						{
							"idle": "(1.0)"
						}
					]
				},
				"walking": {
					"blend_transition": 0.2,
					"animations": [
						{
							"walk": "(1.0)"
						}
					],
					"transitions": [
						{
							"default": "query.ground_speed <= 0.02"
						},
						{
							"attack": "variable.attack_time > 0.0"
						}
					]
				},
				"attack": {
					"blend_transition": 0.12,
					"animations": [
						{
							"attack": "query.has_target&&variable.attack_time>=0"
						}
					],
					"transitions": [
						{
							"default": "query.any_animation_finished"
						},
						{
							"walking": "query.ground_speed > 0.02"
						}
					]
				}
			}
		}
	}
}
