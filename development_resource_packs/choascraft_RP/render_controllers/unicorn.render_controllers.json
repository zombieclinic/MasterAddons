{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.unicorn": {
      "arrays": {
        "textures": {
          "Array.base": [
            "Texture.base_white",
            "Texture.base_creamy",
            "Texture.base_chestnut",
            "Texture.base_brown",
            "Texture.base_black",
            "Texture.base_gray",
            "Texture.base_darkbrown",
            "Texture.base_rainbow"
          ],
          "Array.markings": [
            "Texture.markings_none",
            "Texture.markings_white",
            "Texture.markings_whitefield",
            "Texture.markings_whitedots",
            "Texture.markings_blackdots"
          ],
          "Array.armor": [
            "Texture.armor_none",
            "Texture.armor_leather",
            "Texture.armor_iron",
            "Texture.armor_gold",
            "Texture.armor_diamond",
            "Texture.armor_copper",
            "Texture.armor_netherite"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.base[math.clamp(query.variant, 0, 7)]",
        "Array.markings[math.clamp(query.mark_variant, 0, 4)]",
        "Array.armor[math.clamp(variable.armor_texture_slot, 0, 6)]"
      ],
      "color": {
        "r": "variable.armor_texture_slot == 1 ? query.armor_color_slot(4, 0) : this",
        "g": "variable.armor_texture_slot == 1 ? query.armor_color_slot(4, 1) : this",
        "b": "variable.armor_texture_slot == 1 ? query.armor_color_slot(4, 2) : this",
        "a": "variable.armor_texture_slot == 1 ? query.armor_color_slot(4, 3) : this"
      },
      "part_visibility": [
        {
          "Saddle": "query.is_saddled"
        },
        {
          "Bit*": "query.is_saddled"
        },
        {
          "Bridle": "query.is_saddled"
        },
        {
          "Reins*": "query.is_saddled && query.has_rider"
        },
        {
          "Bag*": "query.is_chested"
        }
      ]
    }
  }
}
