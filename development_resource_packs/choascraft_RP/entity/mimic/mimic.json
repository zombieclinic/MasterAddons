      "scripts": {
        "scale": "(query.property('zombie:mimic_form') == 'villager' || query.property('zombie:mimic_form') == 'steve') ? 0.9375 : 1.0",
        "initialize": [
          "variable.stand_anim = 0.0;",
          "variable.eat_anim = 0.0;",
          "variable.gliding_speed_value = 1.0;",
          "variable.shake_tail = 0.0;"
        ],
        "pre_animation": [
          "variable.head_x_rot = query.target_x_rotation + (query.modified_move_speed > 0.2 ? (math.cos(query.modified_distance_moved * 11.46) * 11.46 * query.modified_move_speed + query.modified_move_speed * 11.46) : 0.0);",
          "variable.inverse_max_stand_eat = 1.0;",
          "variable.leg_stand_factor = math.cos((query.modified_distance_moved * 38.38) + 180.0);",
          "variable.leg_x_rot_anim = variable.leg_stand_factor * 45.8 * query.modified_move_speed;",
          "variable.tcos0 = (math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
          "variable.shake_tail = math.mod(query.life_time, 6.0) < 0.35;"
        ],
        "animate": [
          { "controller": "query.property('zombie:mimic_form') == 'chest' || query.property('zombie:mimic_form') == 'attack'" },
          { "cow_controller": "query.property('zombie:mimic_form') == 'cow'" },
          { "pig_controller": "query.property('zombie:mimic_form') == 'pig'" },
          { "sheep_head_setup": "query.property('zombie:mimic_form') == 'sheep'" },
          { "sheep_move_controller": "query.property('zombie:mimic_form') == 'sheep'" },
          { "look_at_target": "query.property('zombie:mimic_form') == 'sheep'" },
          { "horse_controller": "query.property('zombie:mimic_form') == 'horse'" },
          { "villager_general_controller": "query.property('zombie:mimic_form') == 'villager'" },
          { "villager_move_controller": "query.property('zombie:mimic_form') == 'villager'" },
          { "steve_controller": "query.property('zombie:mimic_form') == 'steve'" }
        ]
      },
      "render_controllers": [
        { "controller.render.mimic.chest": "query.property('zombie:mimic_form') == 'chest' || query.property('zombie:mimic_form') == 'attack'" },
        { "controller.render.mimic.cow": "query.property('zombie:mimic_form') == 'cow'" },
        { "controller.render.mimic.sheep": "query.property('zombie:mimic_form') == 'sheep'" },
        { "controller.render.mimic.pig": "query.property('zombie:mimic_form') == 'pig'" },
