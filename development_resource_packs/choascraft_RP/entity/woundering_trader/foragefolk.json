{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "zombie:foragefolk",
			"materials": {
				"default": "entity_alphatest"
			},
			"textures": {
				"default": "textures/woundering_traders/foragefolks"
			},
			"geometry": {
				"default": "geometry.foragefolk"
			},
			"animations": {
				"walking": "animation.villager.move",
				"lookatplayer": "animation.common.look_at_target",
				"sleeping": "animation.villager.get_in_bed"
			},
			"scripts": {
				"animate": [
					{
						"walking": "query.modified_move_speed >= 0.01 && !query.is_sleeping"
					},
					{
						"lookatplayer": "!query.is_sleeping"
					},
					{
						"sleeping": "query.is_sleeping"
					}
				]
			},
			"render_controllers": [
				"controller.render.default"
			],
			"spawn_egg": {
				"base_color": "#0A3612",
				"overlay_color": "#CFA011"
			}
		}
	}
}
