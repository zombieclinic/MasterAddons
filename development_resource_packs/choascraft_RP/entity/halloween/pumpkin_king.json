                "walk": "animation.pumpkin_boss_walk",
                "walk_battle": "animation.pumpkin_boss_walk_battle",
                "swing_walk": "animation.pumpkin_swing_walk",
                "boss_attack": "animation.pumpkin_boss_attack",
                "boss_attack_2": "animation.pumpkin_boss_attack2",
                "vines": "animation.pumpkin_boss_vines",
                "pumpkin_seed": "animation.pumpkin_boss_pumpkin_seed",
                "rush": "animation.pumpkin_boss_rush",
                "true_face": "animation.pumpkin_boss_true_face",
                "blood_harvest_start": "animation.pumpkin_boss_blood_harvest_start",
                "harvest_success": "animation.pumpkin_boss_blood_harvest_success",
                "harvest_fail": "animation.pumpkin_boss_blood_harvest_fail",
                "hurt": "animation.pumpkin_boss_hurt",
                "death": "animation.pumpkin_boss_death",
