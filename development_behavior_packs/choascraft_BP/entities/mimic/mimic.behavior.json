{
  "format_version": "1.21.20",
  "minecraft:entity": {
    "description": {
      "identifier": "zombie:mimic",
      "spawn_category": "monster",
      "is_spawnable": true,
      "is_summonable": true,
      "properties": {
        "zombie:mimic_form": {
          "type": "enum",
          "values": ["chest", "cow", "sheep", "pig", "horse", "villager", "steve", "attack"],
          "default": "chest",
          "client_sync": true
        },
        "zombie:mimic_horse_color": {
          "type": "int",
          "range": [0, 6],
          "default": 0,
          "client_sync": true
        }
      },
      "animations": { "mimic": "controller.animation.mimic.functions" },
      "scripts": { "animate": ["mimic"] }
    },
    "component_groups": {
      "mimic:initializing": {
        "minecraft:timer": {
          "time": 0.5,
          "time_down_event": { "event": "mimic:start_scan", "target": "self" }
        }
      },
      "mimic:scanning": {
        "minecraft:entity_sensor": {
          "relative_range": false,
          "subsensors": [
            { "range": [10, 5], "event_filters": { "test": "is_family", "subject": "other", "value": "villager" }, "event": "mimic:become_villager" },
            { "range": [10, 5], "event_filters": { "test": "is_family", "subject": "other", "value": "horse" }, "event": "mimic:become_horse" },
            { "range": [10, 5], "event_filters": { "test": "is_family", "subject": "other", "value": "sheep" }, "event": "mimic:become_sheep" },
            { "range": [10, 5], "event_filters": { "test": "is_family", "subject": "other", "value": "cow" }, "event": "mimic:become_cow" },
            { "range": [10, 5], "event_filters": { "test": "is_family", "subject": "other", "value": "pig" }, "event": "mimic:become_pig" }
          ]
        },
        "minecraft:timer": {
          "time": 1.0,
          "time_down_event": { "event": "mimic:random_disguise", "target": "self" }
        }
      },
      "mimic:disguise_lock": {},
      "mimic:passive": {
        "minecraft:movement.basic": {},
        "minecraft:navigation.walk": { "avoid_water": true, "can_pass_doors": true },
        "minecraft:jump.static": {},
        "minecraft:movement": { "value": 0.22 },
        "minecraft:behavior.random_stroll": { "priority": 3, "speed_multiplier": 1.0, "xz_dist": 10, "interval": 10 },
        "minecraft:behavior.look_at_player": { "priority": 6, "look_distance": 6, "probability": 0.04 },
        "minecraft:behavior.random_look_around": { "priority": 7 },
        "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
        "minecraft:interact": { "interactions": [{ "on_interact": { "event": "attack_mode", "target": "self" } }] }
      },
      "mimic:chest": {
        "minecraft:skin_id": { "value": 1 },
        "minecraft:collision_box": { "width": 0.9, "height": 0.9 },
        "minecraft:movement": { "value": 0.0 },
        "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": false },
        "minecraft:knockback_resistance": { "value": 1.0 },
        "minecraft:interact": { "interactions": [{ "on_interact": { "event": "attack_mode", "target": "self" } }] }
      },
      "mimic:cow": {
        "minecraft:collision_box": { "width": 0.9, "height": 1.4 },
        "minecraft:ambient_sound_interval": { "event_name": "mob.cow.say", "range": 8, "value": 8 }
      },
      "mimic:sheep": {
        "minecraft:collision_box": { "width": 0.9, "height": 1.3 },
        "minecraft:color": { "value": 0 },
        "minecraft:behavior.eat_block": { "priority": 6 },
        "minecraft:ambient_sound_interval": { "event_name": "mob.sheep.say", "range": 8, "value": 8 }
      },
      "mimic:pig": {
        "minecraft:collision_box": { "width": 0.9, "height": 0.9 },
        "minecraft:ambient_sound_interval": { "event_name": "mob.pig.say", "range": 8, "value": 8 }
      },
      "mimic:horse": {
        "minecraft:collision_box": { "width": 1.4, "height": 1.6 },
        "minecraft:movement": { "value": 0.25 },
        "minecraft:ambient_sound_interval": { "event_name": "mob.horse.idle", "range": 12, "value": 10 }
      },
      "mimic:villager": {
        "minecraft:collision_box": { "width": 0.6, "height": 1.8 },
        "minecraft:movement": { "value": 0.2 },
        "minecraft:ambient_sound_interval": { "event_name": "mob.villager.idle", "range": 8, "value": 10 },
        "minecraft:behavior.move_towards_dwelling_restriction": { "priority": 4, "speed_multiplier": 0.6 }
      },
      "mimic:steve": {
        "minecraft:collision_box": { "width": 0.6, "height": 1.8 },
        "minecraft:movement": { "value": 0.25 },
        "minecraft:behavior.random_stroll": { "priority": 3, "speed_multiplier": 1.0, "xz_dist": 8, "interval": 20 },
        "minecraft:behavior.look_at_player": { "priority": 6, "look_distance": 15, "probability": 0.02 }
      },
      "mimic:attack": {
        "minecraft:variant": { "value": 2 },
        "minecraft:movement.basic": {},
        "minecraft:navigation.walk": { "is_amphibious": true, "can_pass_doors": true, "can_walk": true, "can_break_doors": true },
        "minecraft:annotation.break_door": {},
        "minecraft:can_climb": {},
        "minecraft:jump.static": {},
        "minecraft:movement": { "value": 0.3 },
        "minecraft:teleport": {
          "random_teleports": true,
          "min_random_teleport_time": 30,
          "max_random_teleport_time": 90,
          "random_teleport_cube": [6, 6, 6],
          "target_distance": 6,
          "target_teleport_chance": 0.01,
          "light_teleport_chance": 0.1,
          "dark_teleport_chance": 0.1
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 1,
          "must_see": true,
          "reselect_targets": true,
          "within_radius": 35,
          "entity_types": [{
            "filters": { "any_of": [
              { "test": "is_family", "subject": "other", "value": "player" }
            ] },
            "max_dist": 35
          }]
        },
        "minecraft:behavior.hurt_by_target": { "priority": 2 },
        "minecraft:behavior.melee_attack": { "priority": 3, "speed_multiplier": 1.15, "track_target": true },
        "minecraft:attack": { "damage": 10 },
        "minecraft:collision_box": { "width": 1.0, "height": 1.0 },
        "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
        "minecraft:loot": { "table": "loot_tables/luckyblock.json" },
        "minecraft:knockback_resistance": { "value": 0.5 },
        "minecraft:boss": { "should_darken_sky": true, "hud_range": 20, "name": "Mimic Chest" }
      }
    },
    "components": {
      "minecraft:physics": { "has_gravity": true, "has_collision": true },
      "minecraft:type_family": { "family": ["monster", "mob", "monsterchest"] },
      "minecraft:nameable": { "allow_name_tag_renaming": true },
      "minecraft:health": { "max": 100, "value": 100 },
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0, "breathes_air": true, "breathes_water": true },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [{
          "filters": { "test": "in_lava", "subject": "self", "value": true },
          "cause": "lava",
          "damage_per_tick": 4
        }]
      },
      "minecraft:despawn": { "despawn_from_distance": {} },
      "minecraft:damage_sensor": { "triggers": [{ "on_damage": { "event": "attack_mode", "target": "self" } }] }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["mimic:initializing", "mimic:chest"] },
        "set_property": { "zombie:mimic_form": "chest" }
      },
      "mimic:underground_disguise": {
        "randomize": [
          { "weight": 1, "trigger": "mimic:become_chest" },
          { "weight": 1, "trigger": "mimic:become_steve" }
        ]
      },
      "mimic:random_disguise": {
        "randomize": [
          { "weight": 1, "trigger": "mimic:become_chest" },
          { "weight": 1, "trigger": "mimic:become_cow" },
          { "weight": 1, "trigger": "mimic:become_sheep" },
          { "weight": 1, "trigger": "mimic:become_pig" },
          { "weight": 1, "trigger": "mimic:become_horse" },
          { "weight": 1, "trigger": "mimic:become_villager" },
          { "weight": 1, "trigger": "mimic:become_steve" }
        ]
      },
      "mimic:start_scan": {
        "first_valid": [
          {
            "filters": { "test": "is_underground", "subject": "self", "value": true },
            "trigger": "mimic:underground_disguise"
          },
          {
            "remove": { "component_groups": ["mimic:initializing", "mimic:disguise_lock"] },
            "add": { "component_groups": ["mimic:scanning"] }
          }
        ]
      },
      "mimic:become_chest": {
        "remove": { "component_groups": ["mimic:initializing", "mimic:scanning", "mimic:passive", "mimic:cow", "mimic:sheep", "mimic:pig", "mimic:horse", "mimic:villager", "mimic:steve"] },
        "add": { "component_groups": ["mimic:chest", "mimic:disguise_lock"] },
        "set_property": { "zombie:mimic_form": "chest" }
      },
      "mimic:become_cow": {
        "remove": { "component_groups": ["mimic:initializing", "mimic:scanning", "mimic:chest", "mimic:sheep", "mimic:pig", "mimic:horse", "mimic:villager", "mimic:steve"] },
        "add": { "component_groups": ["mimic:passive", "mimic:cow", "mimic:disguise_lock"] },
        "set_property": { "zombie:mimic_form": "cow" }
      },
      "mimic:become_sheep": {
        "remove": { "component_groups": ["mimic:initializing", "mimic:scanning", "mimic:chest", "mimic:cow", "mimic:pig", "mimic:horse", "mimic:villager", "mimic:steve"] },
        "add": { "component_groups": ["mimic:passive", "mimic:sheep", "mimic:disguise_lock"] },
        "set_property": { "zombie:mimic_form": "sheep" }
      },
      "mimic:become_pig": {
        "remove": { "component_groups": ["mimic:initializing", "mimic:scanning", "mimic:chest", "mimic:cow", "mimic:sheep", "mimic:horse", "mimic:villager", "mimic:steve"] },
        "add": { "component_groups": ["mimic:passive", "mimic:pig", "mimic:disguise_lock"] },
        "set_property": { "zombie:mimic_form": "pig" }
      },
      "mimic:become_horse": {
        "sequence": [
          {
            "remove": { "component_groups": ["mimic:initializing", "mimic:scanning", "mimic:chest", "mimic:cow", "mimic:sheep", "mimic:pig", "mimic:villager", "mimic:steve"] },
            "add": { "component_groups": ["mimic:passive", "mimic:horse", "mimic:disguise_lock"] },
            "set_property": { "zombie:mimic_form": "horse" }
          },
          {
            "randomize": [
              { "weight": 1, "set_property": { "zombie:mimic_horse_color": 0 } },
              { "weight": 1, "set_property": { "zombie:mimic_horse_color": 1 } },
              { "weight": 1, "set_property": { "zombie:mimic_horse_color": 2 } },
              { "weight": 1, "set_property": { "zombie:mimic_horse_color": 3 } },
              { "weight": 1, "set_property": { "zombie:mimic_horse_color": 4 } },
              { "weight": 1, "set_property": { "zombie:mimic_horse_color": 5 } },
              { "weight": 1, "set_property": { "zombie:mimic_horse_color": 6 } }
            ]
          }
        ]
      },
      "mimic:become_villager": {
        "remove": { "component_groups": ["mimic:initializing", "mimic:scanning", "mimic:chest", "mimic:cow", "mimic:sheep", "mimic:pig", "mimic:horse", "mimic:steve"] },
        "add": { "component_groups": ["mimic:passive", "mimic:villager", "mimic:disguise_lock"] },
        "set_property": { "zombie:mimic_form": "villager" }
      },
      "mimic:become_steve": {
        "remove": { "component_groups": ["mimic:initializing", "mimic:scanning", "mimic:chest", "mimic:cow", "mimic:sheep", "mimic:pig", "mimic:horse", "mimic:villager"] },
        "add": { "component_groups": ["mimic:passive", "mimic:steve", "mimic:disguise_lock"] },
        "set_property": { "zombie:mimic_form": "steve" }
      },
      "attack_mode": {
        "remove": { "component_groups": ["mimic:initializing", "mimic:scanning", "mimic:disguise_lock", "mimic:passive", "mimic:chest", "mimic:cow", "mimic:sheep", "mimic:pig", "mimic:horse", "mimic:villager", "mimic:steve"] },
        "add": { "component_groups": ["mimic:attack"] },
        "set_property": { "zombie:mimic_form": "attack" }
      }
    }
  }
}
