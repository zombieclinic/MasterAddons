        "randomize": [
          {
            "weight": 5,
            "add": {
              "component_groups": [
                "minecraft:zombie_baby"
              ]
            }
          },
          {
            "weight": 95,
            "add": {
              "component_groups": [
                "minecraft:zombie_adult"
              ]
            }
          }
