{
  "format_version": "1.26.30",
  "minecraft:entity": {
    "description": {
      "identifier": "zombie:cobble_golem",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "zombie:tamed": {
        "minecraft:is_tamed": {},
        "minecraft:sittable": {
          "sit_event": { "event": "zombie:on_sit", "target": "self" },
          "stand_event": { "event": "zombie:on_stand", "target": "self" }
        }
      },
      "zombie:tamed_moving": {
        "minecraft:behavior.teleport_to_owner": {
          "priority": 0,
          "cooldown": 1.0,
          "filters": { "test": "owner_distance", "operator": ">", "value": 12 }
        },
        "minecraft:behavior.owner_hurt_by_target": { "priority": 1 },
        "minecraft:behavior.owner_hurt_target": { "priority": 2 },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 3,
          "must_see": true,
          "reselect_targets": true,
          "entity_types": [
            {
              "filters": { "test": "is_family", "subject": "other", "value": "monster" },
              "max_dist": 24,
              "must_see": true
            }
          ]
        },
        "minecraft:behavior.melee_attack": {
          "priority": 4,
          "speed_multiplier": 1.1,
          "track_target": true,
          "reach_multiplier": 1.5
        },
        "minecraft:behavior.follow_owner": {
          "priority": 5,
          "speed_multiplier": 1.1,
          "start_distance": 6,
          "stop_distance": 3
        }
      },
      "zombie:sitting": {
        "minecraft:movement": { "value": 0.0 }
      }
    },
    "components": {
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:type_family": { "family": ["cobble_golem", "golem", "mob"] },
      "minecraft:nameable": {},
      "minecraft:collision_box": { "width": 1.0, "height": 1.2 },
      "minecraft:health": { "value": 100, "max": 100 },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:movement": { "value": 0.25 },
      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "avoid_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:attack": { "damage": { "range_min": 7, "range_max": 21 } },
      "minecraft:knockback_resistance": { "value": 1.0 },
      "minecraft:tameable": {
        "probability": 1.0,
        "tame_items": ["minecraft:cobblestone"],
        "tame_event": { "event": "zombie:on_tame", "target": "self" }
      },
      "minecraft:leashable": {},
      "minecraft:persistent": {},
      "minecraft:behavior.random_stroll": { "priority": 7, "speed_multiplier": 0.6, "xz_dist": 16 },
      "minecraft:behavior.look_at_player": { "priority": 8, "look_distance": 8, "probability": 0.04 },
      "minecraft:behavior.random_look_around": { "priority": 9 },
      "minecraft:physics": { "has_collision": true, "has_gravity": true },
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": true },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:loot": { "table": "loot_tables/mobs/golem_heart.json" }
    },
    "events": {
      "zombie:on_tame": {
        "add": { "component_groups": ["zombie:tamed", "zombie:tamed_moving"] }
      },
      "zombie:on_sit": {
        "remove": { "component_groups": ["zombie:tamed_moving"] },
        "add": { "component_groups": ["zombie:sitting"] }
      },
      "zombie:on_stand": {
        "remove": { "component_groups": ["zombie:sitting"] },
        "add": { "component_groups": ["zombie:tamed_moving"] }
      }
    }
  }
}
