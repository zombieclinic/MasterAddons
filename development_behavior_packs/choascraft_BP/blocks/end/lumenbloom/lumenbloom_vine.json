{
  "format_version": "1.26.20",
  "minecraft:block": {
    "description": {
      "identifier": "zombie:lumenbloom_vine",
      "states": {
        "zombie:vine_stage": ["start", "middle", "end"],
        "zombie:vine_growing": ["yes", "no"]
      },
      "menu_category": { "category": "nature" }
    },
    "components": {
      "minecraft:display_name": "Lumenbloom Vine",
      "minecraft:geometry": "geometry.zombie_abysscrossplants",
      "minecraft:material_instances": { "*": { "texture": "lumenbloom_vine_top", "render_method": "alpha_test", "face_dimming": false, "ambient_occlusion": 0 } },
      "minecraft:item_visual": { "geometry": "geometry.zombie_abysscrossplants", "material_instances": { "*": { "texture": "lumenbloom_vine_top", "render_method": "alpha_test" } } },
      "minecraft:collision_box": false,
      "minecraft:selection_box": { "origin": [-6, 0, -6], "size": [12, 16, 12] },
      "minecraft:destructible_by_mining": { "seconds_to_destroy": 0.1 },
      "minecraft:placement_filter": { "conditions": [{ "allowed_faces": ["down"], "block_filter": ["zombie:lumenbloom_leaves", "zombie:lumenbloom_vine"] }] },
      "minecraft:tags": ["minecraft:is_shears_item_destructible", "plant", "vine"],
      "minecraft:tick": { "looping": true, "interval_range": [2400, 4800] },
      "zombie:lumenbloom_vine_growth": {}
    },
    "permutations": [
      { "condition": "query.block_state('zombie:vine_stage') == 'middle'", "components": { "minecraft:material_instances": { "*": { "texture": "lumenbloom_vine_middle", "render_method": "alpha_test", "face_dimming": false, "ambient_occlusion": 0 } }, "minecraft:loot": "loot_tables/blocks/empty.json" } },
      { "condition": "query.block_state('zombie:vine_stage') == 'end'", "components": { "minecraft:material_instances": { "*": { "texture": "lumenbloom_vine_bottom", "render_method": "alpha_test", "face_dimming": false, "ambient_occlusion": 0 } }, "minecraft:loot": "loot_tables/blocks/empty.json" } },
      { "condition": "query.block_state('zombie:vine_growing') == 'no'", "components": { "minecraft:tick": { "looping": false, "interval_range": [2400, 4800] } } }
    ]
  }
}
