{
  "format_version": "1.26.20",
  "minecraft:block": {
    "description": {
      "identifier": "zombie:lumenroot_log",
      "menu_category": { "category": "construction" },
      "traits": {
        "minecraft:placement_position": {
          "enabled_states": ["minecraft:block_face"]
        }
      }
    },
    "permutations": [
      {
        "condition": "query.block_state('minecraft:block_face') == 'north' || query.block_state('minecraft:block_face') == 'south'",
        "components": { "minecraft:transformation": { "rotation": [90, 0, 0] } }
      },
      {
        "condition": "query.block_state('minecraft:block_face') == 'east' || query.block_state('minecraft:block_face') == 'west'",
        "components": { "minecraft:transformation": { "rotation": [0, 90, -90] } }
      }
    ],
    "components": {
      "minecraft:display_name": "Lumenroot Log",
      "minecraft:destructible_by_mining": { "seconds_to_destroy": 2 },
      "minecraft:destructible_by_explosion": { "explosion_resistance": 3 },
      "minecraft:geometry": "minecraft:geometry.full_block",
      "minecraft:material_instances": {
        "*": { "texture": "lumenroot_log", "render_method": "opaque" },
        "up": { "texture": "lumenroot_log_top", "render_method": "opaque" },
        "down": { "texture": "lumenroot_log_top", "render_method": "opaque" }
      },
      "minecraft:tags": [
        "minecraft:is_axe_item_destructible",
        "zombie:is_strippable",
        "zombie:custom_log",
        "log",
        "wood"
      ],
      "minecraft:map_color": "#37234B"
    }
  }
}
