{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.pumpkin_boss": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {"boat": "query.skin_id == 10"},
            { "final_death": "query.skin_id == 6" },
            { "hurt": "query.skin_id == 1" }
          ]
        },
        "hurt": {
			"on_entry": ["@s hurt"],
			"on_exit": ["@s not_hurt"],
          "transitions": [
            { "final_death": "query.skin_id == 6" },
            { "default": "query.state_time >= 0.5 || query.skin_id != 1" }
          ]
        },
        "final_death": {
          "on_entry": [ "/kill @s" ]
        },
        "boat": {
          "on_entry": [
            "/kill @e[type=boat,r=5]",
            "@s boat_killed"
          ]
        }
      }
    }
  }
}
